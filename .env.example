# مثال لملف متغيرات البيئة لنظام تقييم BTEC
# انسخ هذا الملف إلى .env وقم بتعديل القيم حسب الحاجة

# إعدادات بيئة التطبيق
FLASK_ENV=development
FLASK_APP=wsgi.py
PORT=5000

# المفاتيح السرية
# يجب تغيير هذه القيم في بيئة الإنتاج!
SECRET_KEY=مفتاح-سري-افتراضي-للتطوير-فقط
JWT_SECRET_KEY=مفتاح-سري-jwt-افتراضي-للتطوير-فقط
WTF_CSRF_SECRET_KEY=مفتاح-سري-csrf-افتراضي-للتطوير-فقط
ENCRYPTION_KEY=مفتاح-تشفير-افتراضي-للتطوير-فقط-32-حرف

# إعدادات قاعدة البيانات
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/btec_evaluation

# إعدادات الأمان
TALISMAN_ENABLED=True
TALISMAN_FORCE_HTTPS=False

# إعدادات الذكاء الاصطناعي
AI_ENABLED=True
AI_MODEL=gpt-3.5-turbo
OPENAI_API_KEY=مفتاح-api-مطلوب-للذكاء-الاصطناعي

# إعدادات البلوكتشين
BLOCKCHAIN_ENABLED=False

# إعدادات اللغة
DEFAULT_LANGUAGE=ar
SUPPORTED_LANGUAGES=ar,en

# إعدادات السجلات
LOG_LEVEL=DEBUG
