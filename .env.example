# إعدادات البيئة
FLASK_APP=wsgi.py
FLASK_ENV=development
FLASK_DEBUG=True
LOG_LEVEL=INFO
LOG_FILE=app.log

# المفاتيح السرية
SECRET_KEY=generate-a-secure-secret-key
JWT_SECRET_KEY=generate-a-secure-jwt-secret-key
ENCRYPTION_KEY=generate-a-secure-encryption-key

# قاعدة البيانات
DATABASE_URL=postgresql://user:password@localhost:5432/btec_eval
# أو لـ SQLite المحلي:
# DATABASE_URL=sqlite:///dev.db

# خادم البريد الإلكتروني
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-password
MAIL_DEFAULT_SENDER=noreply@btec-eval.com

# واجهة الذكاء الاصطناعي
AI_API_KEY=your-openai-api-key
AI_API_URL=https://api.openai.com/v1
AI_MODEL=gpt-4-turbo

# Redis (اختياري)
# REDIS_URL=redis://localhost:6379/0
