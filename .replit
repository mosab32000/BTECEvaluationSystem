[deployment]
run = ["sh", "-c", "python backend/wsgi.py"]
build = ["sh", "-c", "pip install -r backend/requirements.txt"]

[workflows]
runButton = "Flask"

[[workflows.workflow]]
name = "Flask"
author = 41069515
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python backend/wsgi.py"
