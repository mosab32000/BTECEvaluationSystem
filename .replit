modules = ["python-3.11", "postgresql-16", "nodejs-20", "python3"]
[deployment]
run = ["sh", "-c", "python backend/wsgi.py"]
build = ["sh", "-c", "pip install -r backend/requirements.txt"]

[workflows]
runButton = "Task Audit App"

[[workflows.workflow]]
name = "Flask"
author = 41069515
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python backend/wsgi.py"

[[workflows.workflow]]
name = "Run Flask Server"
author = 39218537
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python run_flask_server.py"

[[workflows.workflow]]
name = "Task Audit App"
author = 39218537
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python run_flask_server.py"

[nix]
channel = "stable-24_05"

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8000
externalPort = 8000
